{
  "name": "DevDeskApp - Automated Candidate Offer & CTC Salary Breakdown",
  "nodes": [
    {
      "parameters": {},
      "id": "e492b101-1f92-4291-a182-901d7fa13c10",
      "name": "Trigger: New Candidate Offer",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "candidateName",
              "value": "Arjun Sharma"
            },
            {
              "name": "roleTitle",
              "value": "Senior Full-Stack Engineer"
            }
          ],
          "number": [
            {
              "name": "annualCtc",
              "value": 1800000
            },
            {
              "name": "basicPercentage",
              "value": 50
            }
          ]
        },
        "options": {}
      },
      "id": "e492b101-1f92-4291-a182-901d7fa13c11",
      "name": "Candidate Application Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "slugify",
        "textInput": "={{ $json.candidateName + '-' + $json.roleTitle }}"
      },
      "id": "e492b101-1f92-4291-a182-901d7fa13c12",
      "name": "DevDeskApp Candidate Slugifier",
      "type": "n8n-nodes-devdeskapp.devDeskApp",
      "typeVersion": 1,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "resource": "calculator",
        "operation": "ctcToInHand",
        "annualCtc": "={{ $('Candidate Application Data').item.json.annualCtc }}",
        "basicPercentage": "={{ $('Candidate Application Data').item.json.basicPercentage }}"
      },
      "id": "e492b101-1f92-4291-a182-901d7fa13c13",
      "name": "DevDeskApp CTC Calculator",
      "type": "n8n-nodes-devdeskapp.devDeskApp",
      "typeVersion": 1,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const candidate = $('Candidate Application Data').first().json;\nconst slug = $('DevDeskApp Candidate Slugifier').first().json;\nconst calc = $('DevDeskApp CTC Calculator').first().json;\n\nreturn [{\n  json: {\n    offerId: `OFFER-${slug.slug.toUpperCase()}`,\n    candidateName: candidate.candidateName,\n    roleTitle: candidate.roleTitle,\n    annualCtcFormatted: `₹${candidate.annualCtc.toLocaleString('en-IN')}`,\n    monthlyGrossFormatted: `₹${calc.monthlyGross.toLocaleString('en-IN')}`,\n    estimatedMonthlyTakeHome: `₹${calc.monthlyInHand.toLocaleString('en-IN')}`,\n    deductionsSummary: {\n      monthlyBasic: `₹${calc.breakdown.monthlyBasic.toLocaleString('en-IN')}`,\n      monthlyPfEmployee: `₹${calc.breakdown.employeePf.toLocaleString('en-IN')}`,\n      estimatedMonthlyTds: `₹${calc.breakdown.estimatedMonthlyTds.toLocaleString('en-IN')}`,\n      professionalTax: `₹${calc.breakdown.professionalTax}`\n    },\n    legalReference: calc.reference,\n    status: 'READY_TO_DISPATCH'\n  }\n}];"
      },
      "id": "e492b101-1f92-4291-a182-901d7fa13c14",
      "name": "Generate Formal Offer Letter Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        300
      ]
    }
  ],
  "connections": {
    "Trigger: New Candidate Offer": {
      "main": [
        [
          {
            "node": "Candidate Application Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Candidate Application Data": {
      "main": [
        [
          {
            "node": "DevDeskApp Candidate Slugifier",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "DevDeskApp Candidate Slugifier": {
      "main": [
        [
          {
            "node": "DevDeskApp CTC Calculator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "DevDeskApp CTC Calculator": {
      "main": [
        [
          {
            "node": "Generate Formal Offer Letter Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  }
}
