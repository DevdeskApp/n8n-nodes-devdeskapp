    {
      "parameters": {
        "content": "## 🔐 Data Cleaning & Security\n1. **Prettifier:** Unpacks minified JSON into clean human-readable trees.\n2. **SHA-256 Hasher:** Generates cryptographic tamper-proof digest.\n3. **UUID v4:** Stamps every payload with a unique RFC 4122 trace ID.",
        "height": 240,
        "width": 340,
        "color": 5
      },
      "id": "sticky-security",
      "name": "Note: Security & Formatting",
      "type": "n8n-nodes-base.stickyNote",
