        "basicPercentage": "={{ $('Sample Developer & HR Payload').item.json.basicPercentage }}"
      },
      "id": "node-devdesk-ctc",
      "name": "DevDeskApp: CTC Calculator",
      "type": "n8n-nodes-devdeskapp.devDeskApp",
      "typeVersion": 1,
      "position": [
        1480,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const inputData = $('Sample Developer & HR Payload').first().json;\nconst prettified = $('DevDeskApp: JSON Prettifier').first().json;\nconst cryptoHash = $('DevDeskApp: SHA-256 Digest').first().json;\nconst uuidData = $('DevDeskApp: UUID Generator').first().json;\nconst slugData = $('DevDeskApp: Slugifier').first().json;\nconst ctcData = $('DevDeskApp: CTC Calculator').first().json;\n\nreturn [{\n  json: {\n    meta: {\n      traceId: uuidData.uuid,\n      sha256PayloadHash: cryptoHash.hash,\n      candidateFileSlug: slugData.slug,\n      status: 'VERIFIED_AND_PROCESSED',\n      poweredBy: 'DevDeskApp (https://www.devdeskapp.com)'\n    },\n    formattedJsonResult: JSON.parse(prettified.formatted),\n    compensationBreakdown: {\n      annualCtcFormatted: `₹${ctcData.annualCtc.toLocaleString('en-IN')}`,\n      monthlyGross: `₹${ctcData.monthlyGross.toLocaleString('en-IN')}`,\n      netMonthlyTakeHome: `₹${ctcData.monthlyInHand.toLocaleString('en-IN')}`,\n      taxDeductions: {\n        monthlyBasic: `₹${ctcData.breakdown.monthlyBasic.toLocaleString('en-IN')}`,\n        employeePf: `₹${ctcData.breakdown.employeePf.toLocaleString('en-IN')}`,\n        estimatedMonthlyTax: `₹${ctcData.breakdown.estimatedMonthlyTds.toLocaleString('en-IN')}`,\n        professionalTax: `₹${ctcData.breakdown.professionalTax}`\n      },\n      calculatorReference: ctcData.reference\n    }\n  }\n}];"
      },
      "id": "node-final-output",
      "name": "Consolidated Final Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
        420
      ]
    }
