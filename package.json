{
  "name": "n8n-nodes-devdeskapp",
  "version": "0.1.4",
  "description": "Official n8n community node package for DevDeskApp developer utilities, converters, and calculators.",
  "keywords": [
    "n8n-community-node-package",
    "devdeskapp",
    "developer-utilities",
    "json-formatter",
    "ctc-calculator",
    "converters"
  ],
  "license": "MIT",
  "homepage": "https://www.devdeskapp.com",
  "author": {
    "name": "DevDeskApp Community",
    "email": "support@devdeskapp.com",
    "url": "https://www.devdeskapp.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevdeskApp/n8n-nodes-devdeskapp.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node copy-assets.js",
    "dev": "tsc --watch",
